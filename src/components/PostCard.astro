---
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'writing'>; }
const { post } = Astro.props;
const { data, id } = post;
const date = data.pubDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric' });
const slug = id.replace(new RegExp(`^${data.section}/`), '');
const base = `${import.meta.env.BASE_URL}/`;
---
<article class="post-card">
	<p class="meta">{data.section}{data.project && ` · ${data.project}`}</p>
	<h3><a href={`${base}${data.section}/${slug}/`}>{data.title}</a></h3>
	<p>{data.description}</p>
	<time datetime={data.pubDate.toISOString()}>{date}</time>
</article>
<style>
	.post-card { padding: 1.4rem; border: 1px solid var(--line); border-radius: .45rem; background: var(--card); }
	.meta, time { font: 700 .72rem/1.3 system-ui, sans-serif; color: var(--accent); text-transform: uppercase; letter-spacing: .08em; }
	h3 { margin: .55rem 0; font-size: 1.4rem; letter-spacing: -.03em; }
	h3 a { text-decoration: none; } h3 a:hover { color: var(--accent); }
	.post-card > p:not(.meta) { color: var(--muted); line-height: 1.5; margin: 0 0 1rem; }
</style>
