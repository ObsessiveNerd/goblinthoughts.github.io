---
interface Props { title?: string; description?: string; }
const { title = 'Goblin Thoughts', description = 'Notes on making things.' } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><title>{title}</title></head>
	<body>
		<header><nav aria-label="Main navigation"><a class="brand" href="/">Goblin Thoughts</a><div><a href="/games/">Games</a><a href="/film/">Film</a><a href="/ttrpg/">TTRPG</a><a href="/blog/">Blog</a></div></nav></header>
		<main><slot /></main><footer>Made with curiosity and probably too many notes.</footer>
	</body>
</html>
<style is:global>
	:root { --ink: #1c211c; --paper: #f3f0e8; --muted: #62685f; --line: #c9c8ba; --accent: #a44723; --card: #faf8f2; font-family: Georgia, 'Times New Roman', serif; }
	* { box-sizing: border-box; } body { margin: 0; min-width: 320px; background: var(--paper); color: var(--ink); }
	header, main, footer { width: min(100% - 2.5rem, 72rem); margin-inline: auto; }
	nav { display: flex; justify-content: space-between; align-items: baseline; padding: 1.5rem 0; border-bottom: 1px solid var(--line); } nav div { display: flex; gap: 1.1rem; }
	a { color: inherit; } nav a { text-decoration: none; font-size: .92rem; } nav a:hover { color: var(--accent); } .brand { font-weight: 700; letter-spacing: -.03em; font-size: 1.12rem; }
	footer { margin-top: 6rem; padding: 1.75rem 0 3rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .86rem; }
	@media (max-width: 620px) { header, main, footer { width: min(100% - 2rem, 72rem); } nav { align-items: flex-start; gap: 1rem; } nav div { flex-wrap: wrap; justify-content: flex-end; gap: .5rem .85rem; } }
</style>
