---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
const posts = (await getCollection('writing')).filter(({ data }) => !data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const sections = [
	{ slug: 'games', title: 'Games', description: 'Devlogs, prototypes, and things learned while making games.' },
	{ slug: 'film', title: 'Film', description: 'Projects, process notes, and thoughts on moving images.' },
	{ slug: 'ttrpg', title: 'TTRPG', description: 'Systems, sessions, mechanics, and table talk.' },
	{ slug: 'blog', title: 'Blog', description: 'Everything else worth writing down.' },
];
const base = `${import.meta.env.BASE_URL}/`;
---
<Layout title="Goblin Thoughts" description="Notes on games, film, tabletop RPGs, and making things.">
	<section class="hero"><img class="wizard wizard-left" src={`${base}gifs/wizard1.gif`} alt="" /><div class="hero-copy"><p class="eyebrow">⚔ AN 80s FANTASY / COMPUTING TERMINAL ⚔</p><h1>Notes from the workshop.</h1><p class="lede">Devlogs, film projects, tabletop obsessions, and the occasional thought that escaped into the wild.</p><p class="blink">▸ SELECT A PORTAL TO CONTINUE_</p></div><img class="wizard wizard-right" src={`${base}gifs/goblin1.gif`} alt="" /></section>
	<section class="sections" aria-label="Sections">{sections.map((section) => <a class="section-card" href={`${base}${section.slug}/`}><h2>{section.title}</h2><p>{section.description}</p><span>Explore →</span></a>)}</section>
	<section class="latest"><div class="section-heading"><div><p class="eyebrow">✦ RECENT SCROLLS ✦</p><h2>Fresh from the notebook</h2></div><img src={`${base}gifs/pentagram.gif`} alt="" /></div><div class="post-list">{posts.slice(0, 4).map((post) => <PostCard post={post} />)}</div></section>
</Layout>
<style>
	.hero { display: grid; grid-template-columns: minmax(5rem, .8fr) 3fr minmax(5rem, .8fr); align-items: end; gap: 1rem; padding: 4.5rem 0 3rem; } .hero-copy { text-align: center; }.wizard { max-width: 100%; max-height: 13rem; justify-self: center; filter: drop-shadow(0 0 10px rgba(255, 56, 208, .65)); image-rendering: pixelated; }.wizard-left { transform: rotate(-3deg); }.wizard-right { transform: rotate(3deg); } h1 { margin: .5rem 0 1rem; color: var(--gold); font-family: Georgia, serif; font-size: clamp(2.9rem, 8vw, 6.1rem); line-height: .84; letter-spacing: -.07em; text-shadow: 3px 3px #761c73, 6px 6px #19105b; }.lede { margin-inline: auto; font-size: 1.05rem; line-height: 1.65; max-width: 37rem; color: var(--muted); }.eyebrow { margin: 0; font-size: .72rem; font-weight: 700; letter-spacing: .1em; color: var(--acid); }.blink { color: var(--accent); font-size: .8rem; font-weight: 700; animation: blink 1s steps(2, start) infinite; } @keyframes blink { 50% { opacity: 0; } }
	.sections { display: grid; grid-template-columns: repeat(2, 1fr); gap: .8rem; }.section-card { position: relative; display: grid; gap: .6rem; min-height: 12rem; padding: 1.3rem; overflow: hidden; border: 3px ridge var(--line); color: var(--ink); text-decoration: none; background: linear-gradient(140deg, #192a69, #10143d 72%); box-shadow: inset 0 0 22px #050722; transition: transform .18s ease, border-color .18s ease; }.section-card::before { content: "✦"; position: absolute; right: .75rem; color: var(--accent); font-size: 2.5rem; opacity: .35; }.section-card:hover { z-index: 1; border-color: var(--acid); color: white; transform: scale(1.025); }.section-card h2 { margin: 0; color: var(--gold); font-family: Georgia, serif; font-size: 1.7rem; text-shadow: 2px 2px #6a146d; }.section-card p { max-width: 25rem; margin: 0; color: var(--muted); line-height: 1.5; }.section-card span { align-self: end; color: var(--acid); font-size: .8rem; font-weight: 700; }
	.latest { margin-top: 5rem; }.section-heading { display: flex; align-items: center; justify-content: space-between; min-height: 5rem; margin-bottom: 1rem; padding: .6rem 1rem; border: 2px dashed var(--accent); background: rgba(31, 17, 77, .8); }.section-heading img { width: 4rem; height: 4rem; object-fit: contain; mix-blend-mode: screen; }.section-heading h2 { margin: .3rem 0 0; color: var(--gold); font-family: Georgia, serif; font-size: 2rem; letter-spacing: -.04em; }.post-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: .8rem; } @media (max-width: 620px) { .hero { grid-template-columns: 1fr 2.6fr 1fr; gap: .25rem; padding-top: 3rem; } .wizard { max-height: 8rem; } .sections, .post-list { grid-template-columns: 1fr; } }
</style>
