---
import { getCollection, render } from 'astro:content'; import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths() { const posts = await getCollection('writing', ({ data }) => !data.draft); return posts.map((post) => ({ params: { section: post.data.section, slug: post.id.replace(new RegExp(`^${post.data.section}/`), '') }, props: { post } })); }
const { post } = Astro.props; const { Content } = await render(post);
---
<Layout title={`${post.data.title} · Goblin Thoughts`} description={post.data.description}><article class="post"><a class="back" href={`/${post.data.section}/`}>← {post.data.section}</a><p class="meta">{post.data.project || post.data.section}</p><h1>{post.data.title}</h1><p class="dek">{post.data.description}</p><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}</time><div class="content"><Content /></div></article></Layout>
<style>.post { max-width: 46rem; margin: 4rem auto 0; }.back { color: var(--accent); font: 700 .8rem system-ui, sans-serif; text-decoration: none; text-transform: uppercase; letter-spacing: .08em; }.meta { margin: 2.5rem 0 .5rem; color: var(--accent); text-transform: uppercase; letter-spacing: .12em; font: 700 .72rem system-ui, sans-serif; }.post h1 { margin: 0; font-size: clamp(2.8rem, 7vw, 5rem); letter-spacing: -.065em; line-height: .94; }.dek { font-size: 1.22rem; line-height: 1.55; color: var(--muted); }.post time { font: .85rem system-ui, sans-serif; color: var(--muted); }.content { margin-top: 3rem; font-size: 1.12rem; line-height: 1.7; }.content :global(h2) { margin-top: 2.5rem; line-height: 1.1; }.content :global(a) { color: var(--accent); }</style>
